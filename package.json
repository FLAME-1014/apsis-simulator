{
  "name": "apsis-simulator",
  "version": "1.0.0",
  "private": true,
  "description": "An interactive orbital observatory, asteroid collision lab, and Mars lander",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "test:browser": "npm run build && node scripts/browser-check.mjs",
    "test:performance": "npm run build && node scripts/browser-performance.mjs",
    "test:soak": "npm run build && node scripts/browser-soak.mjs",
    "verify:long": "node scripts/long-run.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "playwright": "^1.61.0",
    "vite": "^8.0.0"
  }
}
